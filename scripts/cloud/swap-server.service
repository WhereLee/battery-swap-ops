[Unit]
Description=battery-swap-ops platform server (swap-server)
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/swap
EnvironmentFile=/opt/swap/config/swap.env
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/swap/swap-server-1.0.0.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/swap/logs

[Install]
WantedBy=multi-user.target
