[Unit]
Description=battery-swap-ops device simulator (swap-sim)
After=network.target swap-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/swap
EnvironmentFile=/opt/swap/config/swap.env
ExecStart=/usr/bin/java -Xms128m -Xmx256m -jar /opt/swap/swap-sim-1.0.0.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/swap/logs

[Install]
WantedBy=multi-user.target
